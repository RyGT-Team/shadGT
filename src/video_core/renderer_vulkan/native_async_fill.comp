#version 450
layout(local_size_x=128) in;
layout(set=0, binding=0, std430) writeonly buffer Output { uint words[]; } output_data;
layout(push_constant) uniform Parameters { uint count; uint even_word; uint odd_word; } parameters;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < parameters.count)
        output_data.words[i] = (i & 1u) == 0u ? parameters.even_word : parameters.odd_word;
}
