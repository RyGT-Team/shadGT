// FIX-SGT-206 (ryty_gpu/ryty_gts_dlss.cpp): GT7's motion vectors for the temporal pass that
// reconstructs the scene below the output. The game writes, for each pixel, where it is in this
// frame as drawn (with the frame's sub-pixel jitter) minus where it was in the frame before
// without jitter (measured for DLSS-GT7-001, see dlss_motion.comp). An upscaler wants the motion
// alone: the frame's jitter, in the vectors' own unit, is added back. A vector under -1000 is the
// game's mark for "no history" (mirrors, monitors): no motion is given there.
// The same rule as dlss_motion.comp's SceneVector, without that pass's interface handling: this
// path only runs in a race, whose interface is drawn after the reconstruction.

#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D game_motion;
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D motion;

layout(push_constant) uniform Constants {
    vec2 jitter; // the frame's jitter constants (c20, c21), in the vectors' unit
} constants;

void main() {
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(at, imageSize(motion)))) {
        return;
    }
    const vec2 vector = texelFetch(game_motion, at, 0).xy;
    imageStore(motion, at,
               vec4(vector.x < -1000.0 ? vec2(0.0) : vector + constants.jitter, 0.0, 0.0));
}
